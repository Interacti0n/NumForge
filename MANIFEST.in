include CMakeLists.txt LICENSE README.md CHANGELOG.md
include scripts/check_python_package.py
recursive-include cmake *.cmake *.in
recursive-include include *.h
recursive-include src CMakeLists.txt *.c *.h *.inc
recursive-include bindings/python CMakeLists.txt *.c *.h *.py *.md
recursive-include tests/python *.py
recursive-include examples/python *.py
recursive-include docs *.md
prune build
global-exclude __pycache__ *.py[cod]
