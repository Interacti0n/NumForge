# Start with concrete C correctness checks; broaden only after reviewing findings.
# Broader pointer analysis needs models for status-returning allocation/budget helpers.
Checks: >
  -*,
  bugprone-sizeof-expression,
  bugprone-suspicious-memset-usage,
  bugprone-misplaced-widening-cast,
  clang-analyzer-core.DivideZero
WarningsAsErrors: '*'
# Pointer tables intentionally allocate pointer-sized elements (LLVM 18 flags these).
CheckOptions:
  bugprone-sizeof-expression.WarnOnSizeOfPointerToAggregate: false
HeaderFilterRegex: '(^|[/\\])(src|include|apps)[/\\]'
